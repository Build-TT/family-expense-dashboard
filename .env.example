# FamEx environment variables (Vite — must be prefixed with VITE_)
# Copy to .env and fill in. Do NOT commit your real .env.

# Google Spreadsheet ID — the data source (reads via Sheets API v4)
VITE_SHEET_ID=

# Google API key with read access to the Sheets API
VITE_API_KEY=

# Deployed Google Apps Script web-app URL — handles all writes
# (addTransaction, editTransaction, deleteTransaction, markSettled, etc.)
VITE_GAS_URL=
