# FamEx environment variables (Vite — must be prefixed with VITE_)
# Copy to .env and fill in. Do NOT commit your real .env.

# Google Spreadsheet ID — legacy/default data source.
# Keep this set during migration so the app can fall back safely.
VITE_SHEET_ID=

# Settings spreadsheet ID — stores config/reference tabs and year_files mapping.
# If omitted, VITE_SHEET_ID is used as the settings spreadsheet.
VITE_SETTINGS_SHEET_ID=

# Legacy spreadsheet ID — used when system_settings.storage_mode=legacy
# or when a yearly file has not been mapped yet. If omitted, VITE_SHEET_ID is used.
VITE_LEGACY_SHEET_ID=

# Google API key with read access to the Sheets API
VITE_API_KEY=

# Deployed Google Apps Script web-app URL — handles all writes
# (addTransaction, editTransaction, deleteTransaction, markSettled, etc.)
VITE_GAS_URL=

# Anthropic API key — used ONLY by the Vercel serverless functions in /api
# (e.g. /api/categorize). No VITE_ prefix: this must NOT reach the browser.
# Set it in the Vercel project settings (Environment Variables), and locally
# in .env when running `vercel dev`.
ANTHROPIC_API_KEY=
